{
  "name": "project-broadside",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k \"npm:server\" \"npm:client\"",
    "server": "node server/index.ts",
    "client": "vite",
    "build": "tsc --noEmit && vite build",
    "test": "node --test tests/*.test.js",
    "check": "npm run test && npm run build",
    "test:e2e": "playwright test",
    "test:perf": "BROADSIDE_BENCHMARK=1 playwright test tests/browser/performance.spec.ts --output=test-results-perf"
  },
  "dependencies": {
    "express": "^4.21.2",
    "gun": "^0.2020.1241",
    "three": "^0.180.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@types/express": "^4.17.21",
    "@types/node": "^22.15.0",
    "@types/three": "^0.180.0",
    "concurrently": "^9.1.2",
    "typescript": "^5.8.3",
    "vite": "^6.3.5"
  }
}
